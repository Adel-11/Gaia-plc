
//==============================================================================
// FB_INST_DIP1500
// Kamoer DIP1500 peristaltic pump, Modbus RTU, 32-bit low word first (CDAB)
// 1. INPUTS     : requests, control mode, command source, equipment feedback -> INTERN
// 2. PROCESSING : on INTERN only
// 3. OUTPUTS    : INTERN -> COM / IO / EXC
// Parameters    : pump configuration in PA (persistent), changed from the active local supervision
// Control mode  : local WEBVISU > local HMI > local FUXA > auto (functional units)
//==============================================================================

//------------------------------------------------------------------------------
// 1. INPUTS
//------------------------------------------------------------------------------
	//--- Control mode requests (WEBVISU, HMI, FUXA, global UPI)
	INTERN.FUXA_LOCAL_REQUEST := COM.SCADA_INPUT_LOCAL_REQUEST;
	INTERN.FUXA_AUTO_REQUEST  := COM.SCADA_INPUT_AUTO_REQUEST;
	INTERN.HMI_LOCAL_REQUEST  := COM.HMI_INPUT_LOCAL_REQUEST;
	INTERN.HMI_AUTO_REQUEST   := COM.HMI_INPUT_AUTO_REQUEST;
	INTERN.GLOBAL_LOCAL_FUXA  := EXC.UPI_INPUT_GLOBAL_LOCAL_FUXA;
	INTERN.GLOBAL_LOCAL_HMI   := EXC.UPI_INPUT_GLOBAL_LOCAL_HMI;
	INTERN.WEBVISU_LOCAL_REQUEST := COM.WEBVISU_INPUT_LOCAL_REQUEST;
	INTERN.WEBVISU_AUTO_REQUEST  := COM.WEBVISU_INPUT_AUTO_REQUEST;
	INTERN.GLOBAL_LOCAL_WEBVISU  := EXC.UPI_INPUT_GLOBAL_LOCAL_WEBVISU;

	//--- Control mode
	// Individual memories : set by the local request, reset by the auto request (auto wins if both)
	IF INTERN.WEBVISU_LOCAL_REQUEST THEN
		INTERN.LOCAL_WEBVISU_INDIVIDUAL := TRUE;
	END_IF
	IF INTERN.WEBVISU_AUTO_REQUEST THEN
		INTERN.LOCAL_WEBVISU_INDIVIDUAL := FALSE;
	END_IF
	IF INTERN.HMI_LOCAL_REQUEST THEN
		INTERN.LOCAL_HMI_INDIVIDUAL := TRUE;
	END_IF
	IF INTERN.HMI_AUTO_REQUEST THEN
		INTERN.LOCAL_HMI_INDIVIDUAL := FALSE;
	END_IF
	IF INTERN.FUXA_LOCAL_REQUEST THEN
		INTERN.LOCAL_FUXA_INDIVIDUAL := TRUE;
	END_IF
	IF INTERN.FUXA_AUTO_REQUEST THEN
		INTERN.LOCAL_FUXA_INDIVIDUAL := FALSE;
	END_IF

	// Resulting mode : individual OR global, WEBVISU > HMI > FUXA > auto
	INTERN.LOCAL_WEBVISU := INTERN.LOCAL_WEBVISU_INDIVIDUAL OR INTERN.GLOBAL_LOCAL_WEBVISU;
	INTERN.LOCAL_HMI     := (INTERN.LOCAL_HMI_INDIVIDUAL OR INTERN.GLOBAL_LOCAL_HMI) AND NOT INTERN.LOCAL_WEBVISU;
	INTERN.LOCAL_FUXA    := (INTERN.LOCAL_FUXA_INDIVIDUAL OR INTERN.GLOBAL_LOCAL_FUXA) AND NOT INTERN.LOCAL_WEBVISU AND NOT INTERN.LOCAL_HMI;
	INTERN.AUTO          := NOT INTERN.LOCAL_WEBVISU AND NOT INTERN.LOCAL_HMI AND NOT INTERN.LOCAL_FUXA;

	//--- Command source : local WEBVISU > local HMI > local FUXA > auto (UPI)
	IF INTERN.LOCAL_WEBVISU THEN
		INTERN.CMD_RUN            := COM.WEBVISU_INPUT_MOTOR_START_STOP;
		INTERN.CMD_CLOCKWISE      := COM.WEBVISU_INPUT_MOTOR_DIRECTION;
		INTERN.CMD_VOLUME_MODE    := COM.WEBVISU_INPUT_OPERATION_MODE;
		INTERN.CMD_SPEED          := COM.WEBVISU_INPUT_MOTOR_SPEED.Real_value;
		INTERN.CMD_RUN_SETPOINT   := COM.WEBVISU_INPUT_RUN_TIME_OR_VOLUME_SETPOINT.Real_value;
		INTERN.PARAM_WRITE_ENABLE := COM.WEBVISU_INPUT_PARAM_WRITE_ENABLE;
		INTERN.FLASH_SAVE_REQUEST := COM.WEBVISU_INPUT_FLASH_SAVE;
	ELSIF INTERN.LOCAL_HMI THEN
		INTERN.CMD_RUN            := COM.HMI_INPUT_MOTOR_START_STOP;
		INTERN.CMD_CLOCKWISE      := COM.HMI_INPUT_MOTOR_DIRECTION;
		INTERN.CMD_VOLUME_MODE    := COM.HMI_INPUT_OPERATION_MODE;
		INTERN.CMD_SPEED          := COM.HMI_INPUT_MOTOR_SPEED.Real_value;
		INTERN.CMD_RUN_SETPOINT   := COM.HMI_INPUT_RUN_TIME_OR_VOLUME_SETPOINT.Real_value;
		INTERN.PARAM_WRITE_ENABLE := COM.HMI_INPUT_PARAM_WRITE_ENABLE;
		INTERN.FLASH_SAVE_REQUEST := COM.HMI_INPUT_FLASH_SAVE;
	ELSIF INTERN.LOCAL_FUXA THEN
		INTERN.CMD_RUN            := COM.SCADA_INPUT_MOTOR_START_STOP;
		INTERN.CMD_CLOCKWISE      := COM.SCADA_INPUT_MOTOR_DIRECTION;
		INTERN.CMD_VOLUME_MODE    := COM.SCADA_INPUT_OPERATION_MODE;
		INTERN.CMD_SPEED          := COM.SCADA_INPUT_MOTOR_SPEED.Real_value;
		INTERN.CMD_RUN_SETPOINT   := COM.SCADA_INPUT_RUN_TIME_OR_VOLUME_SETPOINT.Real_value;
		INTERN.PARAM_WRITE_ENABLE := COM.SCADA_INPUT_PARAM_WRITE_ENABLE;
		INTERN.FLASH_SAVE_REQUEST := COM.SCADA_INPUT_FLASH_SAVE;
	ELSE
		// Auto : functional units (UPI)
		INTERN.CMD_RUN            := EXC.UPI_INPUT_RUN;
		INTERN.CMD_CLOCKWISE      := EXC.UPI_INPUT_CLOCKWISE;
		INTERN.CMD_VOLUME_MODE    := EXC.UPI_INPUT_VOLUME_MODE;
		INTERN.CMD_SPEED          := EXC.UPI_INPUT_SPEED;
		INTERN.CMD_RUN_SETPOINT   := EXC.UPI_INPUT_RUN_SETPOINT;
		INTERN.PARAM_WRITE_ENABLE := FALSE;                        // configuration is never written in auto
		INTERN.FLASH_SAVE_REQUEST := FALSE;
	END_IF

	//--- Parameter source : values typed in the active local supervision (nothing in auto)
	IF INTERN.LOCAL_WEBVISU THEN
		INTERN.SRC_MAX_MOTOR_SPEED         := COM.WEBVISU_INPUT_MAX_MOTOR_SPEED.Real_value;
		INTERN.SRC_CALIBRATION_COEFFICIENT := COM.WEBVISU_INPUT_FLOW_RATE_OR_SPEED_CALIBRATION_COEFFICIENT.Real_value;
		INTERN.SRC_FOOT_SWITCH_INPUT_MODE  := COM.WEBVISU_INPUT_FOOT_SWITCH_INPUT_MODE;
		INTERN.SRC_LIQUID_LEVEL_INPUT_MODE := COM.WEBVISU_INPUT_LIQUID_LEVEL_INPUT_MODE;
		INTERN.SRC_STATE_OUTPUT_MODE       := COM.WEBVISU_INPUT_STATE_OUTPUT_MODE;
		INTERN.SRC_COMMUNICATION_ADDRESS   := COM.WEBVISU_INPUT_COMMUNICATION_ADDRESS;
		INTERN.SRC_BAUD_RATE_INDEX         := COM.WEBVISU_INPUT_BAUD_RATE_INDEX;
	ELSIF INTERN.LOCAL_HMI THEN
		INTERN.SRC_MAX_MOTOR_SPEED         := COM.HMI_INPUT_MAX_MOTOR_SPEED.Real_value;
		INTERN.SRC_CALIBRATION_COEFFICIENT := COM.HMI_INPUT_FLOW_RATE_OR_SPEED_CALIBRATION_COEFFICIENT.Real_value;
		INTERN.SRC_FOOT_SWITCH_INPUT_MODE  := COM.HMI_INPUT_FOOT_SWITCH_INPUT_MODE;
		INTERN.SRC_LIQUID_LEVEL_INPUT_MODE := COM.HMI_INPUT_LIQUID_LEVEL_INPUT_MODE;
		INTERN.SRC_STATE_OUTPUT_MODE       := COM.HMI_INPUT_STATE_OUTPUT_MODE;
		INTERN.SRC_COMMUNICATION_ADDRESS   := COM.HMI_INPUT_COMMUNICATION_ADDRESS;
		INTERN.SRC_BAUD_RATE_INDEX         := COM.HMI_INPUT_BAUD_RATE_INDEX;
	ELSIF INTERN.LOCAL_FUXA THEN
		INTERN.SRC_MAX_MOTOR_SPEED         := COM.SCADA_INPUT_MAX_MOTOR_SPEED.Real_value;
		INTERN.SRC_CALIBRATION_COEFFICIENT := COM.SCADA_INPUT_FLOW_RATE_OR_SPEED_CALIBRATION_COEFFICIENT.Real_value;
		INTERN.SRC_FOOT_SWITCH_INPUT_MODE  := COM.SCADA_INPUT_FOOT_SWITCH_INPUT_MODE;
		INTERN.SRC_LIQUID_LEVEL_INPUT_MODE := COM.SCADA_INPUT_LIQUID_LEVEL_INPUT_MODE;
		INTERN.SRC_STATE_OUTPUT_MODE       := COM.SCADA_INPUT_STATE_OUTPUT_MODE;
		INTERN.SRC_COMMUNICATION_ADDRESS   := COM.SCADA_INPUT_COMMUNICATION_ADDRESS;
		INTERN.SRC_BAUD_RATE_INDEX         := COM.SCADA_INPUT_BAUD_RATE_INDEX;
	END_IF

	//--- COM : input registers 0x3001..0x3005
	INTERN.FBK_FIRMWARE_VERSION := COM.COM_INPUT_IR[0];
	INTERN.FBK_HARDWARE_VERSION := COM.COM_INPUT_IR[1];
	INTERN.FBK_TEMPERATURE      := COM.COM_INPUT_IR[2];
	INTERN.FBK_LEVEL_ALARM      := COM.COM_INPUT_IR[3];
	INTERN.FBK_DIGITAL_OUTPUT   := COM.COM_INPUT_IR[4];

	//--- COM : run counters 0x4007..0x400A (format depends on mode)
	IF INTERN.CMD_VOLUME_MODE THEN
		// Volume mode : 32-bit REAL (ml)
		INTERN.FBK_RUN_ACTUAL := FNC_WORDS_TO_REAL(High_word := COM.COM_INPUT_HR_COUNTERS[1], Low_word := COM.COM_INPUT_HR_COUNTERS[0]);
		INTERN.FBK_RUN_TOTAL  := FNC_WORDS_TO_REAL(High_word := COM.COM_INPUT_HR_COUNTERS[3], Low_word := COM.COM_INPUT_HR_COUNTERS[2]);
	ELSE
		// Time mode : 32-bit UDINT (ms)
		INTERN.UDINT_TEMP     := SHL(WORD_TO_UDINT(COM.COM_INPUT_HR_COUNTERS[1]), 16) OR WORD_TO_UDINT(COM.COM_INPUT_HR_COUNTERS[0]);
		INTERN.FBK_RUN_ACTUAL := UDINT_TO_REAL(INTERN.UDINT_TEMP);
		INTERN.UDINT_TEMP     := SHL(WORD_TO_UDINT(COM.COM_INPUT_HR_COUNTERS[3]), 16) OR WORD_TO_UDINT(COM.COM_INPUT_HR_COUNTERS[2]);
		INTERN.FBK_RUN_TOTAL  := UDINT_TO_REAL(INTERN.UDINT_TEMP);
	END_IF


//------------------------------------------------------------------------------
// 2. PROCESSING
//------------------------------------------------------------------------------
	//--- Parameters (PA) : a value changed in the active supervision is saved in PA
	// PA is persistent : it keeps its value after a restart or a download. Default = declaration value.
	// The cycle where the source changes is ignored, so switching mode never overwrites PA.
	INTERN.SOURCE_CHANGED := (INTERN.LOCAL_WEBVISU <> INTERN.PREV_LOCAL_WEBVISU)
	                         OR (INTERN.LOCAL_HMI <> INTERN.PREV_LOCAL_HMI)
	                         OR (INTERN.LOCAL_FUXA <> INTERN.PREV_LOCAL_FUXA);
	INTERN.PREV_LOCAL_WEBVISU := INTERN.LOCAL_WEBVISU;
	INTERN.PREV_LOCAL_HMI     := INTERN.LOCAL_HMI;
	INTERN.PREV_LOCAL_FUXA    := INTERN.LOCAL_FUXA;

	IF NOT INTERN.SOURCE_CHANGED THEN
		IF INTERN.SRC_MAX_MOTOR_SPEED <> INTERN.PREV_SRC_MAX_MOTOR_SPEED THEN
			PA.MAX_MOTOR_SPEED := INTERN.SRC_MAX_MOTOR_SPEED;
		END_IF
		IF INTERN.SRC_CALIBRATION_COEFFICIENT <> INTERN.PREV_SRC_CALIBRATION_COEFFICIENT THEN
			PA.CALIBRATION_COEFFICIENT := INTERN.SRC_CALIBRATION_COEFFICIENT;
		END_IF
		IF INTERN.SRC_FOOT_SWITCH_INPUT_MODE <> INTERN.PREV_SRC_FOOT_SWITCH_INPUT_MODE THEN
			PA.FOOT_SWITCH_INPUT_MODE := INTERN.SRC_FOOT_SWITCH_INPUT_MODE;
		END_IF
		IF INTERN.SRC_LIQUID_LEVEL_INPUT_MODE <> INTERN.PREV_SRC_LIQUID_LEVEL_INPUT_MODE THEN
			PA.LIQUID_LEVEL_INPUT_MODE := INTERN.SRC_LIQUID_LEVEL_INPUT_MODE;
		END_IF
		IF INTERN.SRC_STATE_OUTPUT_MODE <> INTERN.PREV_SRC_STATE_OUTPUT_MODE THEN
			PA.STATE_OUTPUT_MODE := INTERN.SRC_STATE_OUTPUT_MODE;
		END_IF
		IF INTERN.SRC_COMMUNICATION_ADDRESS <> INTERN.PREV_SRC_COMMUNICATION_ADDRESS THEN
			PA.COMMUNICATION_ADDRESS := INTERN.SRC_COMMUNICATION_ADDRESS;
		END_IF
		IF INTERN.SRC_BAUD_RATE_INDEX <> INTERN.PREV_SRC_BAUD_RATE_INDEX THEN
			PA.BAUD_RATE_INDEX := INTERN.SRC_BAUD_RATE_INDEX;
		END_IF
	END_IF

	INTERN.PREV_SRC_MAX_MOTOR_SPEED         := INTERN.SRC_MAX_MOTOR_SPEED;
	INTERN.PREV_SRC_CALIBRATION_COEFFICIENT := INTERN.SRC_CALIBRATION_COEFFICIENT;
	INTERN.PREV_SRC_FOOT_SWITCH_INPUT_MODE  := INTERN.SRC_FOOT_SWITCH_INPUT_MODE;
	INTERN.PREV_SRC_LIQUID_LEVEL_INPUT_MODE := INTERN.SRC_LIQUID_LEVEL_INPUT_MODE;
	INTERN.PREV_SRC_STATE_OUTPUT_MODE       := INTERN.SRC_STATE_OUTPUT_MODE;
	INTERN.PREV_SRC_COMMUNICATION_ADDRESS   := INTERN.SRC_COMMUNICATION_ADDRESS;
	INTERN.PREV_SRC_BAUD_RATE_INDEX         := INTERN.SRC_BAUD_RATE_INDEX;

	//--- Parameters used by the pump : always from PA
	INTERN.CMD_MAX_SPEED      := PA.MAX_MOTOR_SPEED;
	INTERN.CMD_CALIB_COEF     := PA.CALIBRATION_COEFFICIENT;
	INTERN.CMD_FOOT_MODE      := PA.FOOT_SWITCH_INPUT_MODE;
	INTERN.CMD_LEVEL_MODE     := PA.LIQUID_LEVEL_INPUT_MODE;
	INTERN.CMD_STATE_OUT_MODE := PA.STATE_OUTPUT_MODE;
	INTERN.CMD_ADDRESS        := PA.COMMUNICATION_ADDRESS;
	INTERN.CMD_BAUD_INDEX     := PA.BAUD_RATE_INDEX;

	//--- Parameter validity
	INTERN.PARAM_VALID := (WORD_TO_UINT(INTERN.CMD_ADDRESS) >= 1) AND (WORD_TO_UINT(INTERN.CMD_ADDRESS) <= 31)
	                      AND (WORD_TO_UINT(INTERN.CMD_BAUD_INDEX) <= 7)
	                      AND (INTERN.CMD_MAX_SPEED > 0.0) AND (INTERN.CMD_CALIB_COEF > 0.0);

	//--- Flash save : 1 s pulse on rising edge, only with valid parameters
	R_TRIG_FLASH(CLK := INTERN.FLASH_SAVE_REQUEST);
	TP_FLASH(IN := R_TRIG_FLASH.Q AND INTERN.PARAM_VALID, PT := T#1S);
	INTERN.CMD_SAVE_FLASH := TP_FLASH.Q;

	//--- Write triggers (rising edge channels)
	// Square wave 500 ms : each rising edge = one write request
	TON_PULSE(IN := NOT TON_PULSE.Q, PT := T#250MS);
	IF TON_PULSE.Q THEN
		INTERN.PULSE_500MS := NOT INTERN.PULSE_500MS;
	END_IF

	// Command trigger : automatic, 3 s of edges after any command change
	INTERN.CMD_CHANGED := (INTERN.CMD_RUN <> INTERN.PREV_RUN) OR (INTERN.CMD_CLOCKWISE <> INTERN.PREV_CLOCKWISE)
	                      OR (INTERN.CMD_VOLUME_MODE <> INTERN.PREV_VOLUME_MODE) OR (INTERN.CMD_SAVE_FLASH <> INTERN.PREV_SAVE_FLASH)
	                      OR (INTERN.CMD_SPEED <> INTERN.PREV_SPEED) OR (INTERN.CMD_MAX_SPEED <> INTERN.PREV_MAX_SPEED)
	                      OR (INTERN.CMD_RUN_SETPOINT <> INTERN.PREV_RUN_SETPOINT);
	INTERN.PREV_RUN          := INTERN.CMD_RUN;
	INTERN.PREV_CLOCKWISE    := INTERN.CMD_CLOCKWISE;
	INTERN.PREV_VOLUME_MODE  := INTERN.CMD_VOLUME_MODE;
	INTERN.PREV_SAVE_FLASH   := INTERN.CMD_SAVE_FLASH;
	INTERN.PREV_SPEED        := INTERN.CMD_SPEED;
	INTERN.PREV_MAX_SPEED    := INTERN.CMD_MAX_SPEED;
	INTERN.PREV_RUN_SETPOINT := INTERN.CMD_RUN_SETPOINT;

	TOF_CMD_WINDOW(IN := INTERN.CMD_CHANGED, PT := T#3S);
	INTERN.CMD_WINDOW  := TOF_CMD_WINDOW.Q;
	INTERN.CMD_TRIGGER := INTERN.CMD_WINDOW AND (INTERN.CMD_MAX_SPEED > 0.0) AND INTERN.PULSE_500MS;

	// Configuration trigger : only while writing is enabled and parameters are valid
	INTERN.CONFIG_TRIGGER := INTERN.PARAM_WRITE_ENABLE AND INTERN.PARAM_VALID AND INTERN.PULSE_500MS;


//------------------------------------------------------------------------------
// 3. OUTPUTS
//------------------------------------------------------------------------------
	//--- COM : control mode status to SCADA, HMI and WEBVISU
	COM.SCADA_OUTPUT_LOCAL_FUXA_ACTIVE := INTERN.LOCAL_FUXA;
	COM.SCADA_OUTPUT_LOCAL_HMI_ACTIVE  := INTERN.LOCAL_HMI;
	COM.HMI_OUTPUT_LOCAL_ACTIVE        := INTERN.LOCAL_HMI;
	COM.WEBVISU_OUTPUT_LOCAL_ACTIVE        := INTERN.LOCAL_WEBVISU;
	COM.WEBVISU_OUTPUT_LOCAL_HMI_ACTIVE  := INTERN.LOCAL_HMI;
	COM.WEBVISU_OUTPUT_LOCAL_FUXA_ACTIVE := INTERN.LOCAL_FUXA;

	//--- COM : Modbus RTU coils
	COM.COM_OUTPUT_COILS[0] := INTERN.CMD_RUN;           // 0x0001
	COM.COM_OUTPUT_COILS[1] := INTERN.CMD_CLOCKWISE;     // 0x0002
	COM.COM_OUTPUT_COILS[2] := INTERN.CMD_SAVE_FLASH;    // 0x0003
	COM.COM_OUTPUT_COILS[3] := INTERN.CMD_VOLUME_MODE;   // 0x0004

	//--- COM : Modbus RTU holding registers and write triggers
	// Command registers 0x4001..0x4006 (sent on the command trigger)
	FNC_REAL_TO_WORDS(Real_value := INTERN.CMD_SPEED,     High_word => COM.COM_OUTPUT_HR_CMD[1], Low_word => COM.COM_OUTPUT_HR_CMD[0]);   // 0x4001-4002
	FNC_REAL_TO_WORDS(Real_value := INTERN.CMD_MAX_SPEED, High_word => COM.COM_OUTPUT_HR_CMD[3], Low_word => COM.COM_OUTPUT_HR_CMD[2]);   // 0x4003-4004
	IF INTERN.CMD_VOLUME_MODE THEN
		// Run setpoint 0x4005-4006, volume mode : 32-bit REAL (ml)
		FNC_REAL_TO_WORDS(Real_value := INTERN.CMD_RUN_SETPOINT, High_word => COM.COM_OUTPUT_HR_CMD[5], Low_word => COM.COM_OUTPUT_HR_CMD[4]);
	ELSE
		// Run setpoint 0x4005-4006, time mode : 32-bit UDINT (ms)
		INTERN.UDINT_TEMP        := REAL_TO_UDINT(MAX(INTERN.CMD_RUN_SETPOINT, 0.0));
		COM.COM_OUTPUT_HR_CMD[4] := UDINT_TO_WORD(INTERN.UDINT_TEMP);
		COM.COM_OUTPUT_HR_CMD[5] := UDINT_TO_WORD(SHR(INTERN.UDINT_TEMP, 16));
	END_IF

	// Configuration registers 0x400B..0x4011 (sent on the configuration trigger), updated only while enabled and valid
	IF INTERN.PARAM_WRITE_ENABLE AND INTERN.PARAM_VALID THEN
		FNC_REAL_TO_WORDS(Real_value := INTERN.CMD_CALIB_COEF, High_word => COM.COM_OUTPUT_HR_CONFIG[1], Low_word => COM.COM_OUTPUT_HR_CONFIG[0]);   // 0x400B-400C
		COM.COM_OUTPUT_HR_CONFIG[2] := INTERN.CMD_FOOT_MODE;        // 0x400D
		COM.COM_OUTPUT_HR_CONFIG[3] := INTERN.CMD_LEVEL_MODE;       // 0x400E
		COM.COM_OUTPUT_HR_CONFIG[4] := INTERN.CMD_STATE_OUT_MODE;   // 0x400F
		COM.COM_OUTPUT_HR_CONFIG[5] := INTERN.CMD_ADDRESS;          // 0x4010
		COM.COM_OUTPUT_HR_CONFIG[6] := INTERN.CMD_BAUD_INDEX;       // 0x4011
	END_IF

	// Write triggers
	COM.COM_OUTPUT_CMD_TRIGGER    := INTERN.CMD_TRIGGER;
	COM.COM_OUTPUT_CONFIG_TRIGGER := INTERN.CONFIG_TRIGGER;

	//--- COM : feedback to SCADA, HMI and WEBVISU
	COM.SCADA_OUTPUT_FIRMWARE_VERSION                          := INTERN.FBK_FIRMWARE_VERSION;
	COM.HMI_OUTPUT_FIRMWARE_VERSION                            := INTERN.FBK_FIRMWARE_VERSION;
	COM.WEBVISU_OUTPUT_FIRMWARE_VERSION                            := INTERN.FBK_FIRMWARE_VERSION;
	COM.SCADA_OUTPUT_HARDWARE_VERSION                          := INTERN.FBK_HARDWARE_VERSION;
	COM.HMI_OUTPUT_HARDWARE_VERSION                            := INTERN.FBK_HARDWARE_VERSION;
	COM.WEBVISU_OUTPUT_HARDWARE_VERSION                            := INTERN.FBK_HARDWARE_VERSION;
	COM.SCADA_OUTPUT_TEMPERATURE                               := INTERN.FBK_TEMPERATURE;
	COM.HMI_OUTPUT_TEMPERATURE                                 := INTERN.FBK_TEMPERATURE;
	COM.WEBVISU_OUTPUT_TEMPERATURE                                 := INTERN.FBK_TEMPERATURE;
	COM.SCADA_OUTPUT_FLOAT_LEVEL_ALARM                         := INTERN.FBK_LEVEL_ALARM;
	COM.HMI_OUTPUT_FLOAT_LEVEL_ALARM                           := INTERN.FBK_LEVEL_ALARM;
	COM.WEBVISU_OUTPUT_FLOAT_LEVEL_ALARM                           := INTERN.FBK_LEVEL_ALARM;
	COM.SCADA_OUTPUT_DIGITAL_OUTPUT_VALUE                      := INTERN.FBK_DIGITAL_OUTPUT;
	COM.HMI_OUTPUT_DIGITAL_OUTPUT_VALUE                        := INTERN.FBK_DIGITAL_OUTPUT;
	COM.WEBVISU_OUTPUT_DIGITAL_OUTPUT_VALUE                        := INTERN.FBK_DIGITAL_OUTPUT;
	COM.SCADA_OUTPUT_REAL_TIME_RUN_TIME_OR_VOLUME.Real_value   := INTERN.FBK_RUN_ACTUAL;
	COM.HMI_OUTPUT_REAL_TIME_RUN_TIME_OR_VOLUME.Real_value     := INTERN.FBK_RUN_ACTUAL;
	COM.WEBVISU_OUTPUT_REAL_TIME_RUN_TIME_OR_VOLUME.Real_value     := INTERN.FBK_RUN_ACTUAL;
	COM.SCADA_OUTPUT_ACCUMULATED_RUN_TIME_OR_VOLUME.Real_value := INTERN.FBK_RUN_TOTAL;
	COM.HMI_OUTPUT_ACCUMULATED_RUN_TIME_OR_VOLUME.Real_value   := INTERN.FBK_RUN_TOTAL;
	COM.WEBVISU_OUTPUT_ACCUMULATED_RUN_TIME_OR_VOLUME.Real_value   := INTERN.FBK_RUN_TOTAL;

