# All persistent files live here; Coolify mounts a volume at /data.
DATA_DIR=/data
PORT=8000
# Required at first start. Use a long unique password; never commit credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Required random signing secret (at least 32 characters).
SECRET_KEY=
# true for the public HTTPS deployment. false only for localhost HTTP development.
COOKIE_SECURE=true
# Proxy trust: set the Coolify proxy IP/network; * only on an isolated container network.
FORWARDED_ALLOW_IPS=127.0.0.1
